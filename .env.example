APP_NAME="C-Net Library"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cnetlibrary.mciedu.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cnet_library
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cnetlibrary.mciedu.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

CNET_PRODUCTION_URL=https://cnetlibrary.mciedu.com

MCI_CENTRAL_SYNC_ENABLED=false
MCI_CENTRAL_URL=https://mciedu.in
MCI_CENTRAL_TOKEN=
MCI_CENTRAL_BUSINESS_CODE=c-net-library
MCI_CENTRAL_TIMEOUT=10
